# Normalize line endings so an editor rewriting a file wholesale does not turn a
# few-line change into a whole-file diff (which hides real edits during review).
* text=auto eol=crlf

# Sources and docs: CRLF in the working tree, LF in the repository.
*.c      text eol=crlf
*.cpp    text eol=crlf
*.h      text eol=crlf
*.rc     text eol=crlf
*.def    text eol=crlf
*.nsi    text eol=crlf
*.nsh    text eol=crlf
*.admx   text eol=crlf
*.adml   text eol=crlf
*.vcxproj    text eol=crlf
*.vcxproj.filters text eol=crlf
*.sln    text eol=crlf
*.props  text eol=crlf
*.md     text eol=crlf
*.txt    text eol=crlf
*.json   text eol=crlf
*.xml    text eol=crlf

# Shell scripts and CI need LF regardless of platform.
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Binary assets: never touch.
*.png    binary
*.bmp    binary
*.ico    binary
*.zip    binary
*.msi    binary
*.cab    binary
*.exe    binary
*.dll    binary
*.lib    binary
*.pfx    binary
*.cer    binary
*.crl    binary
